# Markdown — ignore all except README.md
*.md
!README.md
!**/README.md

# Cursor config and scripts
.cursor/
*.mdc
*.sh

# JSON — ignore generated/config noise; allow package manifests
*.json
!package.json
!package-lock.json
!playground/package.json
!playground/package-lock.json

# Dependencies and runtime data
node_modules/
playground/node_modules/
playground/data/

# Local secrets
.env
